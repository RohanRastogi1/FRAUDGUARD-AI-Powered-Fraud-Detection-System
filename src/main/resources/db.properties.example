# ============================================================
# FraudGuard Database Connection Configuration Template
# Copy this file to db.properties and set your local credentials
# ============================================================
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/fraudguard_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true&connectTimeout=3000&socketTimeout=3000
db.user=your_db_username
db.password=your_db_password
